# AegisWatch Environment Configuration
# Copy this file to .env and customize as needed.
# Do NOT commit .env to git.

# ── Server ────────────────────────────────────────────────
PORT=8000

# ── Authentication ────────────────────────────────────────
# IMPORTANT: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production-aegiswatch-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────
# Default: SQLite (no setup required)
DATABASE_URL=sqlite+aiosqlite:///./surveillance.db

# For PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aegiswatch

# ── AI Models ────────────────────────────────────────────
# Options: yolov8 | detr | auto
MODEL_NAME=yolov8

# Directory to cache Hugging Face models
MODEL_CACHE_DIR=.cache/hf_models

# ── Detection Settings ────────────────────────────────────
# Minimum confidence for detections (0.0–1.0)
CONFIDENCE_THRESHOLD=0.4

# Process every Nth frame (1 = every frame, 3 = every 3rd frame)
FRAME_SKIP=3

# Seconds before the same event type can trigger again
COOLDOWN_SECONDS=30

# ── Camera Settings ───────────────────────────────────────
# Default webcam index (0 = first webcam, 1 = second, etc.)
CAMERA_ID=0

# Default camera location (for CAM-001)
# These are demo coordinates — configure to your actual location
CAMERA_LATITUDE=28.6139
CAMERA_LONGITUDE=77.2090
CAMERA_LOCATION_NAME=College Main Gate

# ── Feature Flags ─────────────────────────────────────────
# Enable video action classification (requires GPU)
ENABLE_VIDEO_CLASSIFIER=false

# Enable DETR as secondary/backup detector
ENABLE_DETR=false

# ── Demo Mode ─────────────────────────────────────────────
DEMO_MODE=true
